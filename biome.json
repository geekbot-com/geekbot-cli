{
	"$schema": "https://biomejs.dev/schemas/2.4.7/schema.json",
	"files": { "includes": ["**", "!.claude"] },
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": { "noNonNullAssertion": "off" }
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	}
}
